---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { demos } from '../../components/demos';
import { getLab } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getLab();
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const Demo = demos[item.data.component as keyof typeof demos];
if (!Demo) throw new Error(`實驗 ${item.id} 的 component「${item.data.component}」未在 src/components/demos/index.ts 註冊`);
---

<BaseLayout title={item.data.title} description={item.data.summary}>
  <article class="page" data-tone="a">
    <header class="page-head">
      <a class="eyebrow back" href="/works/#lab" data-reveal>← LAB</a>
      <h1 data-reveal data-delay="80">{item.data.title}</h1>
      <p class="page-lead" data-reveal data-delay="160">{item.data.summary}</p>
    </header>
    <div class="page-demo"><Demo /></div>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
