---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLab } from '../../lib/content';

const items = await getLab();
---

<BaseLayout title="實驗室" description="小型互動實驗：演算法視覺化、影像處理與圖學">
  <div class="wrap page">
    <h1>實驗室</h1>
    <p class="lede measure">還不到完整專案規模的小實驗，每一個都可以直接在瀏覽器裡操作。</p>
    <ul class="list">
      {
        items.map((l) => (
          <li>
            <a href={`/lab/${l.id}/`}>{l.data.title}</a>
            <p>{l.data.summary}</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 3rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
  }
  .lede {
    margin-top: 1rem;
    color: var(--muted);
  }
  .list {
    margin-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }
  li {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  li a {
    font-size: 1.25rem;
    font-weight: 650;
  }
  li p {
    margin-top: 0.25rem;
    color: var(--muted);
  }
</style>
