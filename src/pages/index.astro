---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WorkCard from '../components/WorkCard.astro';
import AboutSection from '../components/AboutSection.astro';
import { getWorks } from '../lib/works';

const works = await getWorks();
const featured = works.filter((w) => w.featured);
const shown = featured.length > 0 ? featured : works;
const projectCount = works.filter((w) => w.kind === 'project').length;
const total = shown.length + 1; // 最後一格是「更多」
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout>
  <Hero />

  <section class="works" data-tone="b">
    <div class="wrap-wide works-head">
      <div>
        <div class="eyebrow" data-reveal>01 — SELECTED WORK</div>
        <h2 class="h2" data-reveal data-delay="80">專案展示</h2>
      </div>
      <div class="ctrl" data-reveal data-delay="160">
        <span data-counter>01 / {pad(total)}</span>
        <span class="bar"><i></i></span>
        <div class="ctrl-btns">
          <button class="circle" type="button" data-prev aria-label="上一個">←</button>
          <button class="circle" type="button" data-next aria-label="下一個">→</button>
        </div>
      </div>
    </div>
    <div class="track">
      {shown.map((item) => <WorkCard item={item} />)}
      <div class="more">
        <p>更多專案與實驗</p>
        <div>
          <a href="/works/#project">全部專案（{projectCount}） →</a>
          <a href="/works/#lab">所有實驗 →</a>
        </div>
      </div>
    </div>
  </section>

  <AboutSection />
</BaseLayout>
