---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoSlot from '../../components/DemoSlot.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const { title, summary, cover, coverAlt, stack, tags, role, date, repo, status, demo } = project.data;
const facts = [
  { label: '時間', value: `${date.getFullYear()} 年 ${date.getMonth() + 1} 月${status === '進行中' ? '（進行中）' : ''}` },
  role && { label: '角色', value: role },
  { label: '技術', value: stack.join('、') },
  { label: '類別', value: tags.join('、') },
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout title={title} description={summary}>
  <article class="page" data-tone="a">
    <header class="page-head">
      <a class="eyebrow back" href="/works/#project" data-reveal>← PROJECT</a>
      <h1 data-reveal data-delay="80">{title}</h1>
      <p class="page-lead" data-reveal data-delay="160">{summary}</p>
    </header>

    <div class="page-demo" data-reveal data-delay="200">
      {demo ? <DemoSlot project={project} /> : <Image src={cover} alt={coverAlt} widths={[800, 1280]} sizes="(max-width: 1240px) 100vw, 1240px" />}
    </div>

    <div class="page-body">
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
        {
          repo && (
            <div>
              <dt>原始碼</dt>
              <dd>
                <a href={repo}>GitHub ↗</a>
              </dd>
            </div>
          )
        }
      </dl>
      <div class="prose"><Content /></div>
    </div>

    {
      next && next.id !== project.id && (
        <nav class="next" aria-label="下一個作品">
          <span class="eyebrow">NEXT</span>
          <a href={`/projects/${next.id}/`}>{next.data.title} →</a>
        </nav>
      )
    }
  </article>
</BaseLayout>
