---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { getProjects } from '../../lib/content';
import { TAGS } from '../../content.config';

const projects = await getProjects();
const used = TAGS.filter((t) => projects.some((p) => p.data.tags.includes(t)));
---

<BaseLayout title="作品" description="影像處理、嵌入式與 Web 專案作品集">
  <div class="wrap page">
    <h1>作品</h1>
    {
      used.length > 1 && (
        <div class="filters" role="group" aria-label="依類別篩選">
          <button type="button" class="btn" data-filter="" aria-pressed="true">全部</button>
          {used.map((t) => (
            <button type="button" class="btn" data-filter={t} aria-pressed="false">
              {t}
            </button>
          ))}
        </div>
      )
    }
    <div class="list" data-project-list>
      {projects.map((p) => <ProjectRow project={p} headingLevel="h2" />)}
    </div>
    <p class="empty" data-empty hidden>這個類別目前沒有作品。</p>
  </div>
</BaseLayout>

<script>
  function bindFilters() {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-project-list] [data-tags]'));
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    if (!buttons.length || buttons[0].dataset.bound) return;
    buttons[0].dataset.bound = '1';
    rows.forEach((r, i) => (r.style.viewTransitionName = `project-row-${i}`));

    const apply = (tag: string) => {
      let visible = 0;
      rows.forEach((r) => {
        const show = !tag || (r.dataset.tags ?? '').split(',').includes(tag);
        r.hidden = !show;
        if (show) visible++;
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === tag)));
      if (empty) empty.hidden = visible > 0;
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const tag = b.dataset.filter ?? '';
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (document.startViewTransition && !reduced) document.startViewTransition(() => apply(tag));
        else apply(tag);
      }),
    );
  }
  document.addEventListener('astro:page-load', bindFilters);
</script>

<style>
  .page {
    padding-top: 3rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 2rem 1rem;
  }
  .list {
    margin-top: 1.5rem;
  }
  .list :global([hidden]) {
    display: none;
  }
  .empty {
    color: var(--muted);
    padding-block: 2rem;
  }
</style>
