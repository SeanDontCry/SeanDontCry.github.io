---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const { servicesPage, services, process } = profile;
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title={servicesPage.title} description={servicesPage.lead} contactLead={false}>
  <div class="page" data-tone="a">
    <header class="page-head">
      <div class="eyebrow" data-reveal>SERVICES</div>
      <h1 data-reveal data-delay="80">{servicesPage.title}</h1>
      <p class="page-lead" data-reveal data-delay="160">{servicesPage.lead}</p>
    </header>

    <section class="page-section" aria-labelledby="svc-title">
      <h2 id="svc-title" class="section-title" data-reveal>服務項目</h2>
      <div class="service-grid">
        {
          services.map((s, i) => (
            <div class="service" data-reveal data-delay={String(i * 80)}>
              <span class="num">{pad(i + 1)}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="page-section" aria-labelledby="flow-title">
      <h2 id="flow-title" class="section-title" data-reveal>合作流程</h2>
      <ol class="flow">
        {
          process.map((s, i) => (
            <li data-reveal>
              <span class="num">{pad(i + 1)}</span>
              <div>
                <b>{s.title}</b>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="page-section" aria-labelledby="form-title">
      <h2 id="form-title" class="section-title" data-reveal>聯絡我</h2>
      {
        profile.web3formsKey ? (
          <form class="form" action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value={profile.web3formsKey} />
            <input type="hidden" name="subject" value="個人網站：新的合作詢問" />
            <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
            <label class="field">
              你的稱呼
              <input name="name" required autocomplete="name" />
            </label>
            <label class="field">
              Email
              <input name="email" type="email" required autocomplete="email" />
            </label>
            <label class="field">
              需求描述
              <textarea name="message" rows="6" required placeholder="想解決的問題、預計時程與預算範圍" />
            </label>
            <button class="btn btn-solid" type="submit">送出詢問</button>
          </form>
        ) : (
          <p class="page-lead">
            {profile.email ? (
              <>
                請來信 <a class="link" href={`mailto:${profile.email}`}>{profile.email}</a>，簡述想解決的問題、時程與預算範圍。
              </>
            ) : (
              <>聯絡方式即將更新。</>
            )}
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>
