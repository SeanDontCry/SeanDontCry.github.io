---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到頁面">
  <div class="page" data-tone="a">
    <header class="page-head">
      <div class="eyebrow">404</div>
      <h1>找不到這個頁面</h1>
      <p class="page-lead">網址可能打錯了，或作品已經搬家。可以從作品列表重新找找。</p>
      <div class="row">
        <a class="btn btn-solid" href="/works/">查看所有作品</a>
        <a class="btn" href="/">回到首頁</a>
      </div>
    </header>
  </div>
</BaseLayout>
