---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkRow from '../../components/WorkRow.astro';
import { getWorks } from '../../lib/works';
import { kindLabel } from '../../data/site';

const works = await getWorks();
const count = (kind: 'project' | 'lab') => works.filter((w) => w.kind === kind).length;
const tabs = [
  { id: 'all', label: `全部（${works.length}）` },
  { id: 'project', label: `${kindLabel.project}（${count('project')}）` },
  { id: 'lab', label: `${kindLabel.lab}（${count('lab')}）` },
];
---

<BaseLayout title="專案展示" description="網頁、LINE 應用與影像處理的作品與實驗">
  <section class="index" data-tone="a">
    <div class="works-head">
      <div>
        <div class="eyebrow" data-reveal>INDEX</div>
        <h1 data-reveal data-delay="80">作品與實驗</h1>
      </div>
      <div class="row tabs" data-reveal data-delay="160">
        {
          tabs.map((t, i) => (
            <button class="pill" type="button" data-filter={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {t.label}
            </button>
          ))
        }
      </div>
    </div>
    <div class="list">
      {works.map((item, i) => <WorkRow item={item} index={i} />)}
    </div>
  </section>
</BaseLayout>
