---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel = 'h3' } = Astro.props;
const { title, summary, cover, coverAlt, preview, stack, tags, status, date } = project.data;
const Heading = headingLevel;
const year = date.getFullYear();
---

<article class="row" data-tags={tags.join(',')} data-preview-row>
  <a href={`/projects/${project.id}/`} class="thumb" tabindex="-1" aria-hidden="true">
    <Image
      src={cover}
      alt=""
      widths={[480, 800]}
      sizes="(max-width: 48rem) 100vw, 40vw"
      transition:name={`cover-${project.id}`}
    />
    {preview && <video src={preview} muted loop playsinline preload="none" />}
  </a>
  <div class="body">
    <Heading class="title">
      <a href={`/projects/${project.id}/`}>{title}</a>
    </Heading>
    <p class="summary">{summary}</p>
    <p class="facts">
      <span>{year}</span>
      {status === '進行中' && <span>進行中</span>}
      <span>{stack.join('、')}</span>
    </p>
  </div>
  <span class="sr-only">{coverAlt}</span>
</article>

<script>
  function bindPreviews() {
    document.querySelectorAll<HTMLElement>('[data-preview-row]').forEach((row) => {
      const video = row.querySelector('video');
      if (!video || row.dataset.bound) return;
      row.dataset.bound = '1';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const play = () => {
        video.style.opacity = '1';
        video.play().catch(() => {});
      };
      const stop = () => {
        video.style.opacity = '0';
        video.pause();
      };
      row.addEventListener('pointerenter', play);
      row.addEventListener('pointerleave', stop);
      row.addEventListener('focusin', play);
      row.addEventListener('focusout', stop);
    });
  }
  document.addEventListener('astro:page-load', bindPreviews);
</script>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 1.5rem 2.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--rule);
    align-items: start;
  }
  .thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 4px;
    background: var(--surface);
  }
  .thumb :global(img),
  .thumb video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb video {
    opacity: 0;
    transition: opacity 0.25s;
  }
  .title {
    font-size: 1.45rem;
    font-weight: 650;
    line-height: 1.3;
  }
  .title a {
    text-decoration: none;
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .row {
    position: relative;
  }
  .row:hover .title a {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }
  .summary {
    margin-top: 0.6rem;
    max-width: 34rem;
  }
  .facts {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 48rem) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
