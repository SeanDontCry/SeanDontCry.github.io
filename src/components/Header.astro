---
import { profile } from '../data/profile';
import { nav } from '../data/site';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/"><b>{profile.brand.short}</b><span>{profile.brand.role}</span></a>
    <nav class="nav" aria-label="主要導覽">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={item.match && path.startsWith(item.match) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <button class="theme-btn" type="button" data-theme-toggle aria-label="切換深淺色">
        <i></i><span data-theme-label>深色</span>
      </button>
    </nav>
  </div>
</header>
