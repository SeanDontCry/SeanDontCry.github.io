---
// 瀏覽器端影像濾波 Demo：上傳圖片 → 選運算子 → 拖曳比較前後差異。
// 所有運算都在使用者的瀏覽器內完成，圖片不會上傳到任何伺服器。
---

<div class="demo" data-filter-demo>
  <div class="fd-stage">
    <canvas data-view role="img" aria-label="左側為原圖、右側為處理結果，拖曳分隔線可比較"></canvas>
    <span class="tag left">原圖</span>
    <span class="tag right">處理後</span>
    <p class="status" data-status aria-live="polite"></p>
  </div>

  <div class="panel">
    <label class="field">
      運算子
      <select data-op>
        <option value="sobel">Sobel 邊緣偵測</option>
        <option value="laplacian">Laplacian</option>
        <option value="gaussian">高斯模糊</option>
        <option value="threshold">二值化</option>
      </select>
    </label>
    <label class="field" data-param-wrap>
      <span data-param-label>參數</span>
      <input type="range" data-param />
    </label>
    <button type="button" class="btn" data-auto hidden>以 Otsu 自動求門檻</button>
    <label class="field">
      比較位置
      <input type="range" min="0" max="100" value="50" data-split />
    </label>
    <label class="btn upload">
      選擇自己的圖片
      <input type="file" accept="image/*" data-file class="sr-only" />
    </label>
    <p class="hint">圖片只在你的瀏覽器內處理，不會上傳。</p>
  </div>
</div>

<script>
  import { drawTestChart } from '../../lib/chart';
  import { toGray, toCanvas, sobel, laplacian, gaussianBlur, threshold, otsu, type Gray } from '../../lib/filters';

  const MAX_W = 960;

  function setup(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const view = root.querySelector<HTMLCanvasElement>('[data-view]')!;
    const ctx = view.getContext('2d')!;
    const opSel = root.querySelector<HTMLSelectElement>('[data-op]')!;
    const param = root.querySelector<HTMLInputElement>('[data-param]')!;
    const paramWrap = root.querySelector<HTMLElement>('[data-param-wrap]')!;
    const paramLabel = root.querySelector<HTMLElement>('[data-param-label]')!;
    const autoBtn = root.querySelector<HTMLButtonElement>('[data-auto]')!;
    const split = root.querySelector<HTMLInputElement>('[data-split]')!;
    const file = root.querySelector<HTMLInputElement>('[data-file]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;

    let source: HTMLCanvasElement | null = null;
    let gray: Gray | null = null;
    let result: HTMLCanvasElement | null = null;
    let pending = 0;

    function configureParam() {
      const op = opSel.value;
      autoBtn.hidden = op !== 'threshold';
      if (op === 'gaussian') {
        paramWrap.hidden = false;
        Object.assign(param, { min: '0.5', max: '8', step: '0.5', value: '2.5' });
      } else if (op === 'threshold') {
        paramWrap.hidden = false;
        Object.assign(param, { min: '0', max: '255', step: '1', value: String(gray ? otsu(gray) : 128) });
      } else {
        paramWrap.hidden = true;
      }
      updateLabel();
    }

    function updateLabel() {
      const op = opSel.value;
      paramLabel.textContent = op === 'gaussian' ? `σ = ${param.value}` : op === 'threshold' ? `門檻 T = ${param.value}` : '';
    }

    function process() {
      if (!gray) return;
      const t0 = performance.now();
      const op = opSel.value;
      const v = Number(param.value);
      const out =
        op === 'sobel' ? sobel(gray) : op === 'laplacian' ? laplacian(gray) : op === 'gaussian' ? gaussianBlur(gray, v) : threshold(gray, v);
      result = toCanvas(out);
      status.textContent = `${gray.w}×${gray.h} px，運算 ${Math.round(performance.now() - t0)} ms`;
      draw();
    }

    function queue() {
      updateLabel();
      cancelAnimationFrame(pending);
      pending = requestAnimationFrame(process);
    }

    function draw() {
      if (!source || !result) return;
      const s = (Number(split.value) / 100) * view.width;
      ctx.drawImage(source, 0, 0);
      ctx.save();
      ctx.beginPath();
      ctx.rect(s, 0, view.width - s, view.height);
      ctx.clip();
      ctx.drawImage(result, 0, 0);
      ctx.restore();
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(s - 1, 0, 2, view.height);
    }

    function load(img: CanvasImageSource, w: number, h: number) {
      const k = Math.min(1, MAX_W / w);
      const cw = Math.round(w * k);
      const ch = Math.round(h * k);
      source = document.createElement('canvas');
      source.width = cw;
      source.height = ch;
      const sctx = source.getContext('2d', { willReadFrequently: true })!;
      sctx.drawImage(img, 0, 0, cw, ch);
      gray = toGray(sctx.getImageData(0, 0, cw, ch));
      // 原圖也以灰階顯示，左右才能公平比較
      source = toCanvas(gray);
      view.width = cw;
      view.height = ch;
      configureParam();
      process();
    }

    function loadChart() {
      const c = document.createElement('canvas');
      c.width = 960;
      c.height = 540;
      drawTestChart(c.getContext('2d', { willReadFrequently: true })!, 960, 540);
      load(c, 960, 540);
    }

    file.addEventListener('change', async () => {
      const f = file.files?.[0];
      if (!f) return;
      if (!f.type.startsWith('image/')) {
        status.textContent = '這個檔案不是圖片，請選擇 JPG、PNG 或 WebP。';
        return;
      }
      try {
        const bmp = await createImageBitmap(f);
        load(bmp, bmp.width, bmp.height);
      } catch {
        status.textContent = '無法讀取這張圖片，請換一張試試。';
      }
    });
    opSel.addEventListener('change', () => {
      configureParam();
      queue();
    });
    param.addEventListener('input', queue);
    autoBtn.addEventListener('click', () => {
      if (!gray) return;
      param.value = String(otsu(gray));
      queue();
    });
    split.addEventListener('input', draw);

    let dragging = false;
    const setSplit = (clientX: number) => {
      const r = view.getBoundingClientRect();
      split.value = String(Math.max(0, Math.min(100, ((clientX - r.left) / r.width) * 100)));
      draw();
    };
    view.addEventListener('pointerdown', (e) => {
      dragging = true;
      view.setPointerCapture(e.pointerId);
      setSplit(e.clientX);
    });
    view.addEventListener('pointermove', (e) => dragging && setSplit(e.clientX));
    view.addEventListener('pointerup', () => (dragging = false));

    loadChart();
  }

  // 頁面載入時初始化頁面上所有同類 Demo
  document.querySelectorAll<HTMLElement>('[data-filter-demo]').forEach(setup);
</script>

<style>
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: 1.5rem;
    align-items: start;
  }
  .fd-stage {
    position: relative;
  }
  canvas {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    cursor: ew-resize;
    touch-action: pan-y;
    background: var(--surface);
  }
  .tag {
    position: absolute;
    top: 0.6rem;
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: rgba(16, 22, 32, 0.7);
    color: #fff;
    pointer-events: none;
  }
  .left {
    left: 0.6rem;
  }
  .right {
    right: 0.6rem;
  }
  .status {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--muted);
    font-family: var(--font-mono);
  }
  .panel {
    display: grid;
    gap: 1rem;
  }
  .panel input[type='range'] {
    accent-color: var(--signal);
    padding: 0;
    border: 0;
    background: none;
  }
  .upload {
    justify-content: center;
  }
  .upload:focus-within {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }
  .hint {
    font-size: 0.8rem;
    color: var(--muted);
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 48rem) {
    .demo {
      grid-template-columns: 1fr;
    }
  }
</style>
