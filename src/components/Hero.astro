---
// 首頁主視覺：文字來自 src/data/profile.ts，照片放在 src/assets/img/。
// 互動邏輯在 src/scripts/hero-filter.js。
import { profile } from '../data/profile';
import { Image } from 'astro:assets';
import wallpaper from '../assets/img/wallpaper.jpg';
import portrait from '../assets/img/portrait.jpg';
import pcb1 from '../assets/img/pcb-1.jpg';
import pcb2 from '../assets/img/pcb-2.jpg';

const { hero } = profile;
const filters = [
  { id: 'sobel', label: 'Sobel 邊緣' },
  { id: 'laplacian', label: 'Laplacian' },
  { id: 'gauss', label: '高斯模糊' },
  { id: 'otsu', label: 'Otsu 二值化' },
];
---

<section class="hero" data-tone="a">
  <div class="hero-bg" aria-hidden="true">
    <Image src={wallpaper} alt="" widths={[960, 1600, 2400]} sizes="100vw"
           loading="eager" fetchpriority="high" />
  </div>
  <div class="hero-grid">
    <div class="hero-text">
      <div class="eyebrow hero-eyebrow" data-reveal>{hero.eyebrow}</div>
      <div class="hero-titles">
        <h1 data-reveal data-delay="80">
          {hero.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}
        </h1>
        <div class="hero-sub" data-reveal data-delay="140">
          {hero.subtitle.map((line) => <><br />{line}</>)}
        </div>
      </div>
      <div class="hero-actions">
        <p class="hero-lead" data-reveal data-delay="200">{hero.lead}</p>
        <div class="row" data-reveal data-delay="260">
          <a class="btn btn-solid" href="/works/">專案展示 →</a>
          {profile.resume && <a class="btn" href={profile.resume}>下載履歷</a>}
        </div>
      </div>
    </div>

    <figure class="hero-fig" data-reveal data-delay="120">
      <div class="stage">
        <div class="pcb p1"><canvas data-pcb data-photo={pcb1.src} aria-label="PCB 電路板，移動游標查看濾波效果"></canvas></div>
        <div class="pcb p2"><canvas data-pcb data-photo={pcb2.src} aria-label="PCB 電路板，移動游標查看濾波效果"></canvas></div>
        <div class="frame">
          <div class="frame-inner">
            <canvas
              data-hero-canvas
              data-ratio="3/4"
              width="600"
              height="800"
              data-photo={portrait.src}
              aria-label="即時影像濾波示範，移動游標查看效果"></canvas>
            <div class="frame-tag" data-source-label>載入中…</div>
            <div class="frame-vig"></div>
          </div>
          <div class="frame-stamp">{hero.stamp.map((s) => <span>{s}</span>)}</div>
        </div>
      </div>
      <div class="controls">
        <div>
          {
            filters.map((f, i) => (
              <button class="pill" type="button" data-filter-btn={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {f.label}
              </button>
            ))
          }
        </div>
        <div>
          <label class="chip">更換影像<input type="file" accept="image/*" data-file hidden /></label>
          <button class="chip" type="button" data-cam><span class="dot"></span><span data-cam-label>改用鏡頭</span></button>
        </div>
      </div>
      <figcaption class="cap">
        <div class="kernel" data-kernel></div>
        <div class="mono otsu" data-otsu hidden>t* = <span data-otsu-t>—</span></div>
        <div class="note" data-filter-note></div>
      </figcaption>
      <div class="note" data-cam-error hidden>無法開啟鏡頭，已改用靜態影像。</div>
    </figure>
  </div>
</section>

<script>
  import '../scripts/hero-filter.js';
</script>
