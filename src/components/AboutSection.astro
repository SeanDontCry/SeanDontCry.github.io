---
import { profile } from '../data/profile';
---

<section class="about" id="about" data-tone="c">
  <div>
    <div class="eyebrow" data-reveal>02 — ABOUT</div>
    <h2 class="h2" data-reveal data-delay="80">經歷與技能</h2>
    <div class="skills" data-reveal data-delay="160">
      {profile.skills.map((s) => <span>{s}</span>)}
    </div>
  </div>
  <div class="tl">
    <span class="tl-fill"></span>
    <ol>
      {
        profile.timeline.map((t) => (
          <li data-reveal>
            <span class="yr">{t.period}</span>
            <div>
              <b>{t.title}</b>
              <small>{t.org}</small>
              {t.note && <small class="muted">{t.note}</small>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
