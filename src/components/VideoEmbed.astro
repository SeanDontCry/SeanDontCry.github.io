---
interface Props {
  youtubeId: string;
  title: string;
}
const { youtubeId, title } = Astro.props;
---

<div class="video">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0`}
    title={title}
    loading="lazy"
    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen></iframe>
</div>

<style>
  .video {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface);
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
